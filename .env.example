# Copy to .env.local (never commit). Public values bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:15321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<local anon key from `supabase status`>
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SENTRY_DSN=

# Local stack only: to run the platform-setup API tests (npm run test:e2e, project api-setup) put the next line in supabase/functions/.env
# (gitignored) BEFORE `supabase start`. It is a public literal; the function refuses it on any hosted project, and it must never be set on one.
# PLATFORM_SETUP_TOKEN=local-setup-token-not-a-secret-0123456789
